# ZAYKA VIP Restaurant - Server Configuration
PORT=5000
JWT_SECRET=zayka_royal_vip_secret_key_2026_super_secure

# Google OAuth 2.0 Credentials (Optional for real Google verification)
# 1. Create a project at https://console.cloud.google.com/
# 2. Configure OAuth consent screen
# 3. Create Credentials -> OAuth Client ID (Web Application)
# 4. Set Authorized JavaScript origins to http://localhost:5173 and http://localhost:5000
# 5. Paste Client ID and Client Secret below:
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Note: The application also includes an instant 1-Click Google Test Flow for development,
# so Google Login functions smoothly out-of-the-box even before entering production keys!
